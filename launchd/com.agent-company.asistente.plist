<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agent-company.asistente</string>
  <!-- Vigilante: cada 5 min relanza la sesión tmux del asistente si no existe. -->
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>-lc</string><string>~/.claude/agent-company/asistente.sh</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <!-- Sin esto launchd mata el servidor tmux al acabar cada pasada. -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/tmp/agent-company-asistente.log</string>
  <key>StandardErrorPath</key><string>/tmp/agent-company-asistente.log</string>
</dict>
</plist>
